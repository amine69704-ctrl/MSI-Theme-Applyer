<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MSI THEME APPLYER"
        android:textColor="#00E5FF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select any .mtz file to import &amp; apply theme"
        android:textColor="#B0B0B0"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnGrantPermission"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="1. Grant All Files Access"
        android:backgroundTint="#FF6D00"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSelectMtz"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="2. Select .MTZ Theme File"
        android:backgroundTint="#2979FF"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvSelectedFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No file selected"
        android:textColor="#FFFFFF"
        android:textAlignment="center"
        android:padding="12dp"
        android:background="#1E1E1E"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnApplyTheme"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="3. IMPORT &amp; APPLY THEME"
        android:backgroundTint="#00C853"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:enabled="false" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Waiting for file..."
        android:textColor="#80CBC4"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginTop="20dp" />

</LinearLayout>
